{% liquid
  assign settings = product.metafields.pre_order.settings.value
  assign selected_variant = product.selected_or_first_available_variant
%}

{% if settings.active and selected_variant.available %}
  <div class="pre-order-block-{{ block.id }}" data-pre-order-block="{{ block.id }}">
    <form method="post" action="/cart/add" enctype="multipart/form-data">
      <input type="hidden" name="id" value="{{ selected_variant.id }}">
      <input type="hidden" name="selling_plan" value="{{ settings.sellingPlanNumericId }}">
      <input type="hidden" name="properties[_Pre-order]" value="true">
      <input
        type="hidden"
        name="return_to"
        value="{% if block.settings.destination == 'checkout' %}/checkout{% else %}/cart{% endif %}"
      >

      <button class="pre-order-button-{{ block.id }}" type="submit">
        <span class="pre-order-button-label-{{ block.id }}">{{ block.settings.button_label }}</span>
      </button>

      {% if block.settings.show_deposit_message %}
        {% liquid
          if settings.depositType == 'percentage'
            assign deposit_label = settings.depositValue | append: '%'
          else
            assign deposit_label = settings.depositValue | times: 100 | money
          endif

          assign deposit_message = block.settings.deposit_message_text

          if deposit_message == blank
            assign deposit_message = 'Pay {deposit} today. Balance due {days} days after checkout.'
          endif

          assign deposit_message = deposit_message | replace: '{deposit}', deposit_label | replace: '{days}', settings.balanceDueDays
        %}
        <p class="pre-order-note-{{ block.id }}">
          {{ deposit_message }}
        </p>
      {% endif %}
    </form>
  </div>

  <style>
    .pre-order-block-{{ block.id }} {
      margin-block: 16px;
    }

    .pre-order-button-{{ block.id }} {
      appearance: none;
      background: {{ block.settings.button_background }};
      border: 0;
      border-radius: {{ block.settings.border_radius }}px;
      box-shadow:
        0 5px 0 rgba(0, 0, 0, 0.62),
        0 12px 20px rgba(0, 0, 0, 0.24),
        inset 0 1px 0 rgba(255, 255, 255, 0.2);
      color: {{ block.settings.button_text }};
      cursor: pointer;
      display: inline-flex;
      font: inherit;
      font-weight: 600;
      justify-content: center;
      min-height: 48px;
      overflow: hidden;
      padding: 12px 24px;
      position: relative;
      transform: translateY(0);
      transition:
        box-shadow 180ms ease,
        transform 180ms ease,
        filter 180ms ease;
      width: 100%;
    }

    .pre-order-button-{{ block.id }}::after {
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.16), transparent 42%);
      border-radius: inherit;
      content: "";
      inset: 0;
      pointer-events: none;
      position: absolute;
    }

    .pre-order-button-{{ block.id }}::before {
      background: linear-gradient(
        110deg,
        transparent 0%,
        transparent 34%,
        rgba(255, 255, 255, 0.32) 48%,
        transparent 62%,
        transparent 100%
      );
      content: "";
      inset: 0;
      position: absolute;
      transform: translateX(-120%);
    }

    .pre-order-button-label-{{ block.id }} {
      position: relative;
      text-shadow: 0 1px 0 rgba(0, 0, 0, 0.35);
      z-index: 1;
    }

    .pre-order-button-{{ block.id }}:hover {
      box-shadow:
        0 7px 0 rgba(0, 0, 0, 0.66),
        0 16px 24px rgba(0, 0, 0, 0.28),
        inset 0 1px 0 rgba(255, 255, 255, 0.24);
      filter: brightness(1.05);
      transform: translateY(-2px);
    }

    .pre-order-button-{{ block.id }}:hover::before {
      animation: pre-order-shine-{{ block.id }} 900ms ease;
    }

    .pre-order-button-{{ block.id }}:active {
      box-shadow:
        0 2px 0 rgba(0, 0, 0, 0.66),
        0 6px 12px rgba(0, 0, 0, 0.22),
        inset 0 2px 6px rgba(0, 0, 0, 0.28);
      transform: translateY(3px);
    }

    .pre-order-button-{{ block.id }}:focus-visible {
      outline: 3px solid rgba(35, 115, 255, 0.55);
      outline-offset: 4px;
    }

    @keyframes pre-order-shine-{{ block.id }} {
      from {
        transform: translateX(-120%);
      }

      to {
        transform: translateX(120%);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .pre-order-button-{{ block.id }} {
        transition: none;
      }

      .pre-order-button-{{ block.id }}:hover::before {
        animation: none;
      }
    }

    .pre-order-note-{{ block.id }} {
      color: rgba(18, 18, 18, 0.75);
      font-size: 0.92em;
      margin: 10px 0 0;
    }
  </style>

  {% if block.settings.hide_theme_purchase_buttons %}
    <script>
      (() => {
        const block = document.querySelector('[data-pre-order-block="{{ block.id }}"]');

        if (!block) return;

        const selectors = [
          'button[name="add"]',
          'input[name="add"]',
          'form[action*="/cart/add"] button[name="add"]',
          'form[action*="/cart/add"] input[name="add"]',
          'form[action*="/cart/add"] [type="submit"][name="add"]',
          'form[action*="/cart/add"] button[type="submit"]',
          'product-form button[name="add"]',
          '.product-form__submit',
          '.product-form__buttons',
          '.shopify-payment-button',
          '.shopify-payment-button__button',
          '.shopify-payment-button__more-options',
          'shopify-accelerated-checkout',
          'shopify-buy-it-now-button'
        ];

        const hidePurchaseButtons = () => {
          for (const element of document.querySelectorAll(selectors.join(','))) {
            if (block.contains(element)) continue;
            if (element.closest('[data-pre-order-block="{{ block.id }}"]')) continue;

            element.setAttribute('hidden', '');
            element.setAttribute('aria-hidden', 'true');
            element.style.setProperty('display', 'none', 'important');
          }
        };

        hidePurchaseButtons();
        window.addEventListener('load', hidePurchaseButtons, { once: true });
        setTimeout(hidePurchaseButtons, 250);
        setTimeout(hidePurchaseButtons, 1000);

        new MutationObserver(hidePurchaseButtons).observe(document.documentElement, {
          childList: true,
          subtree: true
        });
      })();
    </script>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Pre-order button",
  "target": "section",
  "templates": ["product"],
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Pre-order now"
    },
    {
      "type": "checkbox",
      "id": "show_deposit_message",
      "label": "Show deposit message",
      "default": true
    },
    {
      "type": "text",
      "id": "deposit_message_text",
      "label": "Deposit message text",
      "default": "Pay {deposit} today. Balance due {days} days after checkout.",
      "info": "Use {deposit} for the deposit amount and {days} for the balance due days."
    },
    {
      "type": "checkbox",
      "id": "hide_theme_purchase_buttons",
      "label": "Hide theme Add to cart and Buy now buttons",
      "default": true
    },
    {
      "type": "select",
      "id": "destination",
      "label": "After pre-order, send customers to",
      "options": [
        {
          "value": "cart",
          "label": "Cart"
        },
        {
          "value": "checkout",
          "label": "Checkout"
        }
      ],
      "default": "cart"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "default": 4
    }
  ]
}
{% endschema %}
